# ---------- API image: FastAPI + LangGraph + RAG ----------
FROM python:3.10-slim

# No .pyc files, and print logs immediately
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# 0) newer pip: the pip that ships with the base image cannot read the PyTorch index
#    properly (it tried to build typing_extensions from source and failed)
RUN pip install --no-cache-dir --upgrade pip

# 1) torch (CPU version) first: keeps the image small, no GPU needed
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 2) the rest of the packages (copied first so Docker can cache this layer)
COPY docker/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# 3) download the embedding model once, at build time (so startup is fast)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

# 4) our code (data/ and .env are NOT copied: they come from docker-compose)
COPY src ./src

EXPOSE 8000

# If the FAISS index does not exist yet, build it from data/raw, then start the API
CMD ["sh", "-c", "test -d data/processed/faiss_index || python -m src.vectorstore.faiss_store; exec uvicorn src.api.main:app --host 0.0.0.0 --port 8000"]
