# ---- LLM Provider ----
# "groq" (current default, free tier) | "huggingface" | "openai"
LLM_PROVIDER=groq

# Groq (OpenAI-compatible API). Create a key at console.groq.com -> API Keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Hugging Face (did not work on a free account for Llama 3)
HUGGINGFACEHUB_API_TOKEN=hf_your-token-here
HF_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Optional: OpenAI fallback
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector Store ----
FAISS_INDEX_DIR=data/processed/faiss_index

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K_RESULTS=4

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
